{
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/privacy",
        "destination": "/privacy.html"
      },
      {
        "source": "/terms",
        "destination": "/terms.html"
      },
      {
        "source": "/apps",
        "destination": "/apps.html"
      },
      {
        "source": "/games",
        "destination": "/games.html"
      },
      {
        "source": "/iptv-viewer/privacy",
        "destination": "/iptv-viewer/privacy.html"
      },
      {
        "source": "/iptv-viewer/delete-data",
        "destination": "/iptv-viewer/delete-data.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ]
  }
}
